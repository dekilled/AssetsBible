    "nome": "Query Selector Helper",
    "tipo": "javascript",
    "categoria": "DOM",
    "descricao": "Atalho para document.querySelector/querySelectorAll com nomes curtos.",
    "tags": [
      "dom",
      "helpers"
    ],
    "codigo": "const $ = (sel, ctx = document) => ctx.querySelector(sel);\nconst $$ = (sel, ctx = document) => Array.from(ctx.querySelectorAll(sel));",
    "previewHtml": "<div class=\"item\">Item 1</div>\n<div class=\"item\">Item 2</div>\n<div class=\"item\">Item 3</div>\n<p id=\"out\" style=\"font-family:sans-serif;\"></p>\n<script>\n  const $ = (sel, ctx = document) => ctx.querySelector(sel);\n  const $$ = (sel, ctx = document) => Array.from(ctx.querySelectorAll(sel));\n  document.getElementById('out').textContent = 'Encontrados: ' + $$('.item').length + ' itens';\n</script>",
    "variacoes": []
  },
