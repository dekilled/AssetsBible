    "id": "8f14e45f-ceea-4b7d-8e5f-000000000001",
    "nome": "Debounce",
    "tipo": "javascript",
    "categoria": "Utils",
    "descricao": "Atrasa a execução de uma função até X ms após a última chamada. Útil para inputs de busca, resize, scroll.",
    "tags": [
      "performance",
      "eventos"
    ],
    "codigo": "function debounce(fn, delay) {\n  let timer;\n  return (...args) => {\n    clearTimeout(timer);\n    timer = setTimeout(() => fn(...args), delay);\n  };\n}\n\n// uso:\nconst log = debounce((msg) => console.log(msg), 300);",
    "previewHtml": "<input id=\"i\" placeholder=\"Digite algo...\" style=\"font-family:sans-serif;padding:8px;width:100%;box-sizing:border-box;\" />\n<p id=\"out\" style=\"font-family:sans-serif;color:#555;\"></p>\n<script>\n  function debounce(fn, delay) {\n    let timer;\n    return (...args) => {\n      clearTimeout(timer);\n      timer = setTimeout(() => fn(...args), delay);\n    };\n  }\n  const out = document.getElementById('out');\n  const onType = debounce((v) => { out.textContent = 'Debounced: ' + v; }, 400);\n  document.getElementById('i').addEventListener('input', (e) => onType(e.target.value));\n</script>",
    "variacoes": [
      {
        "nome": "Com cancelamento",
        "codigo": "function debounce(fn, delay) {\n  let timer;\n  const debounced = (...args) => {\n    clearTimeout(timer);\n    timer = setTimeout(() => fn(...args), delay);\n  };\n  debounced.cancel = () => clearTimeout(timer);\n  return debounced;\n}"
      }
    ]
  },
  {
    "id": "8f14e45f-ceea-4b7d-8e5f-000000000002",
    "nome": "Throttle",
    "tipo": "javascript",
    "categoria": "Utils",
    "descricao": "Garante que uma função só execute no máximo uma vez a cada X ms.",
    "tags": [
      "performance",
      "eventos"
    ],
    "codigo": "function throttle(fn, limit) {\n  let inThrottle = false;\n  return (...args) => {\n    if (!inThrottle) {\n      fn(...args);\n      inThrottle = true;\n      setTimeout(() => (inThrottle = false), limit);\n    }\n  };\n}",
    "previewHtml": "<button id=\"b\" style=\"font-family:sans-serif;padding:8px 16px;\">Clique rápido várias vezes</button>\n<p id=\"out\" style=\"font-family:sans-serif;color:#555;\">Cliques processados: 0</p>\n<script>\n  function throttle(fn, limit) {\n    let inThrottle = false;\n    return (...args) => {\n      if (!inThrottle) {\n        fn(...args);\n        inThrottle = true;\n        setTimeout(() => (inThrottle = false), limit);\n      }\n    };\n  }\n  let count = 0;\n  const out = document.getElementById('out');\n  const onClick = throttle(() => { count++; out.textContent = 'Cliques processados: ' + count; }, 1000);\n  document.getElementById('b').addEventListener('click', onClick);\n</script>",
    "variacoes": []
  },
  {
    "id": "8f14e45f-ceea-4b7d-8e5f-000000000003",
    "nome": "Deep Clone",
    "tipo": "javascript",
    "categoria": "Arrays",
    "descricao": "Clona objetos e arrays profundamente usando structuredClone (com fallback via JSON).",
    "tags": [
      "objetos",
      "clone"
    ],
    "codigo": "function deepClone(value) {\n  if (typeof structuredClone === 'function') {\n    return structuredClone(value);\n  }\n  return JSON.parse(JSON.stringify(value));\n}",
    "previewHtml": "<pre id=\"out\" style=\"font-family:monospace;background:#f4f4f4;padding:12px;\"></pre>\n<script>\n  function deepClone(value) {\n    if (typeof structuredClone === 'function') return structuredClone(value);\n    return JSON.parse(JSON.stringify(value));\n  }\n  const original = { a: 1, nested: { b: 2 } };\n  const cloned = deepClone(original);\n  cloned.nested.b = 999;\n  document.getElementById('out').textContent =\n    'original: ' + JSON.stringify(original) + '\\ncloned:   ' + JSON.stringify(cloned);\n</script>",
    "variacoes": []
  },
  {
